{
  "name": "insidejibon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--require=./scripts/node-net-fix.cjs next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--require=./scripts/node-net-fix.cjs drizzle-kit migrate",
    "db:studio": "NODE_OPTIONS=--require=./scripts/node-net-fix.cjs drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.9",
    "@clerk/nextjs": "^7.7.9",
    "@clerk/shared": "^4.29.2",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.124.0"
  }
}
