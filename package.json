{
  "name": "insidejibon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--require=./scripts/node-net-fix.cjs next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build:cf": "opennextjs-cloudflare build && node scripts/build-classroom-room.mjs",
    "preview": "npm run build:cf && wrangler dev",
    "deploy": "npm run build:cf && npm run deploy:only",
    "deploy:only": "node scripts/build-classroom-room.mjs && OPEN_NEXT_DEPLOY=true wrangler deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "NODE_OPTIONS=--require=./scripts/node-net-fix.cjs drizzle-kit migrate",
    "db:studio": "NODE_OPTIONS=--require=./scripts/node-net-fix.cjs drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/backend": "^3.16.9",
    "@clerk/nextjs": "^7.7.9",
    "@clerk/shared": "^4.29.2",
    "@neondatabase/serverless": "^1.1.0",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.140.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
