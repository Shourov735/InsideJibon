{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "insidejibon",
  "main": ".open-next/worker.js",
  "account_id": "d02c23a9fea237c9db99e911edc0553e",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // ---------------------------------------------------------------------------
  // R0 remaster infra bindings.
  //
  // The IDs below are PLACEHOLDERS. The Cloudflare operator must create the
  // real KV namespaces and Queues once via the Wrangler CLI before deploying
  // (or before this JSON becomes valid). Until then, `wrangler deploy` will
  // fail with a "namespace not found" error pointing at the missing resource.
  //
  // Commands to run from the project root:
  //
  //   wrangler kv namespace create insidejibon-rate-limit
  //   wrangler kv namespace create insidejibon-session
  //   wrangler kv namespace create insidejibon-feature-flags
  //   wrangler queues create insidejibon-notifications
  //   wrangler queues create insidejibon-embeddings
  //   wrangler queues create insidejibon-csv-exports
  //
  // Paste the returned IDs back into this file under the corresponding
  // `id` field. No subscriptions are involved; everything is on the Workers
  // Free plan (FREE-TIER-REFERENCE.md §1, §2, §4).
  // ---------------------------------------------------------------------------
  "kv_namespaces": [
    { "binding": "RATE_LIMIT_KV",    "id": "REPLACE_ME_rate_limit" },
    { "binding": "SESSION_KV",       "id": "REPLACE_ME_session" },
    { "binding": "FEATURE_FLAGS_KV", "id": "REPLACE_ME_feature_flags" }
  ],
  "queues": {
    "producers": [
      { "binding": "NOTIFICATIONS_QUEUE", "queue": "insidejibon-notifications" },
      { "binding": "EMBEDDINGS_QUEUE",    "queue": "insidejibon-embeddings" },
      { "binding": "EXPORT_QUEUE",        "queue": "insidejibon-csv-exports" }
    ]
  },
  "r2_buckets": [
    {
      "binding": "MATERIALS_BUCKET",
      "bucket_name": "insidejibon-materials"
    },
    {
      "binding": "PUBLIC_BUCKET",
      "bucket_name": "insidejibon-public"
    }
  ],

  // ---------------------------------------------------------------------------
  // R4 remaster: weekly leaderboard cron.
  // R5 remaster: streak-freeze (Mon 00:00), weekly-leagues (Sun 23:59),
  // energy-refill tick (every 5 min).
  //
  // The Cron Trigger fires the matching route in src/app/api/cron/*:
  //   - 13 */2 * * *      leaderboard        (R4 — every 2 hours)
  //   - 0  0  * * 1       streak-freezes     (R5 — Mon 00:00 UTC)
  //   - 59 23 * * 0       weekly-leagues     (R5 — Sun 23:59 UTC)
  //   - */5 * * * *       energy-refill      (R5 — every 5 min)
  //
  // Cloudflare's Free plan allows 5 Cron Triggers per worker — we use 4,
  // leaving 1 slot for an R7/R8/R9 cron. See docs/remaster-phase-5-gamification.md §5.
  // ---------------------------------------------------------------------------
  "triggers": {
    "crons": [
      "13 */2 * * *",
      "0 0 * * 1",
      "59 23 * * 0",
      "*/5 * * * *"
    ]
  },

  "observability": {
    "enabled": true
  }
}
