# --- Clerk (auth) ---
# Get these from `clerk env pull` after linking: clerk link --app <app_id>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Optional: webhook signing secret (used in Phase 1 for user sync)
# CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Neon (PostgreSQL) ---
# Connection string from: neonctl connection-string --project-id <project_id>
DATABASE_URL=postgresql://user:password@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require