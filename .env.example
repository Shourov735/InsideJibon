# --- Clerk (auth) ---
# Get these from `clerk env pull` after linking: clerk link --app <app_id>
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# Optional: webhook signing secret (used in Phase 1 for user sync)
# CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Neon (PostgreSQL) ---
# Connection string from: neonctl connection-string --project-id <project_id>
DATABASE_URL=postgresql://user:password@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require

# --- R0 remaster infra (Cloudflare Free plan) ---
# KV namespaces — only needed for local dev. In production they are Worker
# bindings and do NOT need .env entries. Mirror URLs are used by `wrangler
# dev` to talk to the remote KV from your local machine.
# RATE_LIMIT_KV_URL=https://...
# SESSION_KV_URL=https://...
# FEATURE_FLAGS_KV_URL=https://...

# --- R2 public bucket ---
# Public origin configured for the insidejibon-public bucket. Set this
# to the R2 custom domain (e.g. https://cdn.insidejibon.com) once the
# operator has wired it up in the Cloudflare dashboard. Until then,
# the bucket is not used for asset URLs.
# PUBLIC_BUCKET_PUBLIC_URL=https://cdn.insidejibon.com